# Files whose bytes are checked by digest must not get CR LF line ends on a Windows checkout
# (core.autocrlf): each game's replay recordings, their sound configurations and goldens (the
# goldens name the recordings by SHA-256), and the shell scripts.
**/tests/replay/*.rec binary
**/tests/replay/*.cfg binary
**/tests/replay/golden/** binary
*.png binary
*.sh text eol=lf
# Keep the workspace copies identical after a fresh Windows handoff checkout.
uw1/docs/i18n/HANDOFF.md text eol=lf
uw1/docs/i18n/PLAYTEST_PACKAGING.md text eol=lf
# Translation datasets: l10n.py reads them byte-exact (LF only), and an empty last
# tab-separated field is data, not trailing whitespace.
uw1/i18n/**/*.tsv text eol=lf whitespace=-blank-at-eol
uw2/i18n/**/*.tsv text eol=lf whitespace=-blank-at-eol
